# IP address browsers can reach this host on, advertised for the TURN
# packet-loss relay (e.g. your LAN IP, or a VPS's public IP).
TURN_PUBLIC_IP=192.168.1.10

# Optional overrides
#HOST_PORT=8080
#TURN_PORT=3478
#BASE_PATH=/speedtest
#SERVER_NAME=myserver
#MAX_BYTES=1000000000
#TRUSTED_PROXY=true
